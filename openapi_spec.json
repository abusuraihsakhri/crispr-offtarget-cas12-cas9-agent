{
  "openapi": "3.1.0",
  "info": {
    "title": "CRISPR Off-Target Agent API",
    "description": "Research-use deterministic audit utilities. The sequence heuristic is exposed through the CLI and browser application, not this API.",
    "version": "2.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service status"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus metrics",
        "responses": {
          "200": {
            "description": "Prometheus text exposition",
            "content": {
              "text/plain": {}
            }
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate a deterministic rule-subsystem payload",
        "responses": {
          "200": {
            "description": "Consensus dossier"
          },
          "400": {
            "description": "Sensitive identifier rejected"
          },
          "422": {
            "description": "Payload validation failed"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Use the deterministic local query responder",
        "responses": {
          "200": {
            "description": "Deterministic response"
          },
          "400": {
            "description": "Sensitive identifier rejected"
          },
          "422": {
            "description": "Payload validation failed"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve the in-memory audit hash chain",
        "responses": {
          "200": {
            "description": "Audit entries and integrity status"
          }
        }
      }
    }
  }
}
